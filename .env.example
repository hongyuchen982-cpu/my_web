# Local database fallback
DATABASE_URL="file:./dev.db"

# Production Turso database (takes precedence when configured)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# GitHub portfolio source
GITHUB_USERNAME="hongyuchen982-cpu"
GITHUB_TOKEN=""
# Comma-separated full repository names; only these forks appear as candidates
GITHUB_INCLUDED_FORKS="hongyuchen982-cpu/workflowWithComfyUI"

# Password-protected project manager at /admin/projects
ADMIN_PASSWORD=""
# Generate a random value of at least 32 characters; never expose it to the browser
ADMIN_SESSION_SECRET=""
# 本地开发可留空；生产环境必须填写至少 32 个随机字符。

# OpenAI-compatible embedding endpoint (OpenAI, SiliconFlow, etc.)
AI_PROVIDER="ollama"
CHAT_PROVIDER="ollama"
OPENROUTER_API_KEY=""
CHAT_MODEL=""
CHAT_API_KEY=""
CHAT_BASE_URL=""
CHAT_ALLOWED_MODELS=""
EMBEDDING_PROVIDER="ollama"
TRUST_PROXY="false"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_CHAT_MODEL="qwen2.5:3b"
OLLAMA_EMBEDDING_MODEL="qwen3-embedding:0.6b"
# Below this top cosine score, the assistant refuses to answer
RAG_MIN_SCORE="0.45"
# Minimum semantic support between each answer paragraph and its cited chunk
RAG_CITATION_MIN_SCORE="0.40"

# Set AI_PROVIDER=openai-compatible when using these cloud settings
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL="https://api.openai.com/v1"
EMBEDDING_MODEL="text-embedding-3-small"
