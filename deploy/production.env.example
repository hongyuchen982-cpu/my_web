NODE_ENV=production
DATABASE_URL=file:/data/prod.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
TRUST_PROXY=true
SITE_ICP_RECORD=
SITE_POLICE_RECORD=
GITHUB_USERNAME=hongyuchen982-cpu
GITHUB_TOKEN=
# Many free chat models; get your own key. Never put keys into NEXT_PUBLIC variables.
CHAT_PROVIDER=openrouter
OPENROUTER_API_KEY=
CHAT_MODEL=openrouter/free
# Alternative: CHAT_PROVIDER=siliconflow; review prices before adding allowed IDs.
CHAT_API_KEY=
CHAT_ALLOWED_MODELS=
CHAT_BASE_URL=
# Embeddings are independent; select ONE provider/model and rebuild all indexes.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=
RAG_MIN_SCORE=0.45
RAG_CITATION_MIN_SCORE=0.40
